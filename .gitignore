.venv/
venv/
.env
.env.*
!.env.example
*.pem
*.key

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地数据与产出
data/*.db
