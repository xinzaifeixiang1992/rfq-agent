# ---------- 数据底座 ----------
# sqlite：本地开发（Git4Data 由仿真层模拟）；matrixone：正式环境（原生 Git4Data）
DB_BACKEND=sqlite
SQLITE_PATH=data/rfq.db
MO_HOST=
MO_PORT=6001
MO_USER=
MO_PASSWORD=
MO_DATABASE=rfq_agent_v2
# 网络/服务端异常时快速失败，避免 DATA BRANCH DIFF 永久占住 API worker
MO_CONNECT_TIMEOUT=10
MO_READ_TIMEOUT=120
MO_WRITE_TIMEOUT=60
MO_DIFF_TIMEOUT=12
# 使用 MOI 工作区数据库时，填写连接串中的 --init-command
MO_INIT_COMMAND=

# ---------- 记忆层 ----------
# local：业务库中的普通表（开发用）
# git4data：记忆主线 mem_main 由 Git4Data 管理（MatrixOne 原生分支/快照/RESTORE；SQLite 下仿真）——推荐
# memoria：Memoria 云 / 自部署 REST，API Key 在 https://thememoria.ai/app 申请（MOI 的 Key 不通用）
MEMORY_BACKEND=git4data
MEMORIA_URL=https://api.thememoria.ai
MEMORIA_API_KEY=

# ---------- 模型（OpenAI 兼容接口） ----------
# 留空则路由器降级为规则引擎，主流程仍可跑通
LLM_BASE_URL=
LLM_API_KEY=
MODEL_FAST=deepseek-v4.1-flash
MODEL_STRONG=deepseek-v4-pro
MODEL_VISION=qwen3.8-max

# ---------- 服务 ----------
API_BASE=http://127.0.0.1:8000

# ---------- 公网演示防护 ----------
# DEMO_MODE=true：隐藏管理按钮（需 ?admin 并输入口令才显示）、写接口按客户端 IP 限流
DEMO_MODE=false
# 管理接口（/admin/reset、/admin/demo/legacy-poison）须 ALLOW_ADMIN_RESET=true 且请求头 X-Admin-Token 与此一致
ADMIN_TOKEN=
ALLOW_ADMIN_RESET=false
RATE_LIMIT_WRITES=30
RATE_LIMIT_WINDOW=60
